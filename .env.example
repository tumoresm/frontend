# FieldForce Client Environment Configuration
# Copy this file to .env and fill in your actual values

# Appwrite Configuration
APPWRITE_PROJECT_ID=your_project_id_here
DATABASE_ID=fieldforce_db
STORAGE_ID=your_storage_bucket_id_here
APPWRITE_ENDPOINT=http://192.168.100.5/v1

# FastAPI Server Configuration
FASTAPI_ENDPOINT=http://192.168.100.5:8000

# API Configuration
# API_TIMEOUT=30000

# App Configuration
# APP_NAME=FieldForce
# APP_VERSION=1.0.0

# Debug Configuration
# DEBUG_MODE=true
# ENABLE_LOGGING=true